{
  "name": "theatre-manager",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:unit": "node --no-warnings --test tests/activity.test.mjs tests/feedback.test.mjs tests/firestore-values.test.mjs tests/member-invite-email.test.mjs tests/member-invites.test.mjs tests/project-revisions.test.mjs",
    "test:conflict": "firebase emulators:exec --only firestore --project seisakuboard-conflict-test \"node --no-warnings --test tests/conflict.integration.test.mjs\"",
    "test:rules": "firebase emulators:exec --only firestore --project seisakuboard-rules-test \"node --test tests/firestore.rules.test.mjs\""
  },
  "dependencies": {
    "firebase": "^13.0.0",
    "firebase-admin": "^14.5.0",
    "next": "16.4.0",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "resend": "^6.33.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "firebase-tools": "^15.33.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6",
    "source-map-js": "1.2.2"
  }
}
