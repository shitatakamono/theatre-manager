NEXT_PUBLIC_FIREBASE_API_KEY=
# 本番ではアプリと同一origin（例: seisakuboard.geki-curry.com）を指定します。
# localhostでは既定の <project-id>.firebaseapp.com のままで構いません。
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_PROJECT_ACCESS_MODE=strict
# 公開するアプリのorigin（例: https://example.com）。metadataとOAuth callbackの生成に使用します
NEXT_PUBLIC_APP_URL=
RESEND_API_KEY=
INVITE_EMAIL_FROM=
INVITE_EMAIL_REPLY_TO=
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
OPENAI_API_KEY=
OPENAI_REHEARSAL_IMPORT_MODEL=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_TOKEN_ENCRYPTION_KEY=
# Optional: 未設定時は実行環境に応じたcallback URLを使用します
GOOGLE_CALENDAR_REDIRECT_URI=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
