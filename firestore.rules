rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function memberPath(projectId) {
      return /databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid);
    }

    function isMember(projectId) {
      return signedIn() && exists(memberPath(projectId));
    }

    function role(projectId) {
      return get(memberPath(projectId)).data.role;
    }

    function canEdit(projectId) {
      return isMember(projectId) && role(projectId) in ['owner', 'editor'];
    }

    function isOwner(projectId) {
      return isMember(projectId) && role(projectId) == 'owner';
    }

    function validRole(value) {
      return value in ['owner', 'editor', 'viewer'];
    }

    function validActivityLog() {
      return request.resource.data.keys().hasOnly([
          'actorUid', 'actorName', 'action', 'section', 'sectionLabel',
          'changedFields', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'actorUid', 'actorName', 'action', 'section', 'sectionLabel',
          'changedFields', 'createdAt'
        ])
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.actorName is string
        && request.resource.data.actorName.size() > 0
        && request.resource.data.actorName.size() <= 100
        && request.resource.data.action in ['create', 'update', 'delete']
        && request.resource.data.section is string
        && request.resource.data.sectionLabel is string
        && request.resource.data.changedFields is list
        && request.resource.data.changedFields.size() > 0
        && request.resource.data.changedFields.size() <= 50
        && request.resource.data.createdAt == request.time;
    }

    function validFeedbackStatus(value) {
      return value in ['unreviewed', 'planned', 'resolved', 'wontfix'];
    }

    function validFeedbackCreate(projectId) {
      return request.resource.data.keys().hasOnly([
          'type', 'body', 'status', 'reporterUid', 'reporterName',
          'reporterRole', 'currentPath', 'pageLabel', 'adminNote',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'type', 'body', 'status', 'reporterUid', 'reporterName',
          'reporterRole', 'currentPath', 'pageLabel', 'adminNote',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.type in ['bug', 'improvement', 'confusing', 'other']
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 5000
        && request.resource.data.status == 'unreviewed'
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.reporterName is string
        && request.resource.data.reporterName.size() > 0
        && request.resource.data.reporterName.size() <= 100
        && request.resource.data.reporterRole == role(projectId)
        && request.resource.data.currentPath is string
        && request.resource.data.currentPath.size() > 0
        && request.resource.data.currentPath.size() <= 500
        && request.resource.data.pageLabel is string
        && request.resource.data.pageLabel.size() > 0
        && request.resource.data.pageLabel.size() <= 100
        && request.resource.data.adminNote == ''
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function validFeedbackUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'adminNote', 'updatedAt'])
        && validFeedbackStatus(request.resource.data.status)
        && request.resource.data.adminNote is string
        && request.resource.data.adminNote.size() <= 5000
        && request.resource.data.updatedAt == request.time;
    }

    function validRehearsalType(value) {
      return value in ['acting', 'stage_combat', 'japanese_dance', 'meeting', 'other'];
    }

    function validRehearsalData() {
      return request.resource.data.keys().hasOnly([
          'startAt', 'endAt', 'type', 'customType', 'venue', 'content', 'note',
          'revision', 'createdAt', 'updatedAt', 'createdByUid', 'updatedByUid'
        ])
        && request.resource.data.keys().hasAll([
          'startAt', 'endAt', 'type', 'customType', 'venue', 'content', 'note',
          'revision', 'createdAt', 'updatedAt', 'createdByUid', 'updatedByUid'
        ])
        && request.resource.data.startAt is timestamp
        && (request.resource.data.endAt == null
          || (request.resource.data.endAt is timestamp
            && request.resource.data.endAt > request.resource.data.startAt))
        && validRehearsalType(request.resource.data.type)
        && request.resource.data.customType is string
        && request.resource.data.customType.size() <= 100
        && ((request.resource.data.type == 'other' && request.resource.data.customType.size() > 0)
          || (request.resource.data.type != 'other' && request.resource.data.customType == ''))
        && request.resource.data.venue is string
        && request.resource.data.venue.size() <= 200
        && request.resource.data.content is string
        && request.resource.data.content.size() <= 2000
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 5000
        && request.resource.data.revision is int
        && request.resource.data.revision >= 0
        && request.resource.data.createdByUid is string
        && request.resource.data.updatedByUid is string;
    }

    function validRehearsalCreate() {
      return validRehearsalData()
        && request.resource.data.revision == 0
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.updatedByUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function validRehearsalUpdate() {
      return validRehearsalData()
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdByUid == resource.data.createdByUid
        && request.resource.data.updatedByUid == request.auth.uid
        && request.resource.data.updatedAt == request.time;
    }

    function participantPath(projectId, participantId) {
      return /databases/$(database)/documents/projects/$(projectId)/participants/$(participantId);
    }

    function participantLinkedUserPath(projectId, uid) {
      return /databases/$(database)/documents/projects/$(projectId)/participantLinkedUsers/$(uid);
    }

    function validSpecialPractice(value) {
      return value in ['none', 'stage_combat', 'japanese_dance'];
    }

    function validParticipantData() {
      return request.resource.data.keys().hasOnly([
          'displayName', 'specialPractice', 'linkedUserUid', 'publicNote', 'active',
          'createdAt', 'updatedAt', 'createdByUid', 'updatedByUid'
        ])
        && request.resource.data.keys().hasAll([
          'displayName', 'specialPractice', 'linkedUserUid', 'publicNote', 'active',
          'createdAt', 'updatedAt', 'createdByUid', 'updatedByUid'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 100
        && validSpecialPractice(request.resource.data.specialPractice)
        && (request.resource.data.linkedUserUid == null
          || (request.resource.data.linkedUserUid is string
            && request.resource.data.linkedUserUid.size() > 0
            && request.resource.data.linkedUserUid.size() <= 128))
        && request.resource.data.publicNote is string
        && request.resource.data.publicNote.size() <= 2000
        && request.resource.data.active is bool
        && request.resource.data.createdByUid is string
        && request.resource.data.updatedByUid is string;
    }

    function linkedUserPointsToParticipant(projectId, participantId, linkedUserUid) {
      return linkedUserUid == null
        || (exists(projectMemberPath(projectId, linkedUserUid))
          && existsAfter(participantLinkedUserPath(projectId, linkedUserUid))
          && getAfter(participantLinkedUserPath(projectId, linkedUserUid)).data.participantId == participantId);
    }

    function oldParticipantLinkReleased(projectId) {
      return resource.data.linkedUserUid == null
        || resource.data.linkedUserUid == request.resource.data.linkedUserUid
        || !existsAfter(participantLinkedUserPath(projectId, resource.data.linkedUserUid));
    }

    function validParticipantCreate(projectId, participantId) {
      return validParticipantData()
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.updatedByUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && linkedUserPointsToParticipant(projectId, participantId, request.resource.data.linkedUserUid);
    }

    function validParticipantUpdate(projectId, participantId) {
      return validParticipantData()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdByUid == resource.data.createdByUid
        && request.resource.data.updatedByUid == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && linkedUserPointsToParticipant(projectId, participantId, request.resource.data.linkedUserUid)
        && oldParticipantLinkReleased(projectId);
    }

    function validParticipantLinkedUserData(projectId, uid) {
      return request.resource.data.keys().hasOnly(['participantId'])
        && request.resource.data.keys().hasAll(['participantId'])
        && request.resource.data.participantId is string
        && existsAfter(participantPath(projectId, request.resource.data.participantId))
        && getAfter(participantPath(projectId, request.resource.data.participantId)).data.linkedUserUid == uid;
    }

    function previousParticipantLinkReleased(projectId, uid) {
      return resource.data.participantId == request.resource.data.participantId
        || !existsAfter(participantPath(projectId, resource.data.participantId))
        || getAfter(participantPath(projectId, resource.data.participantId)).data.linkedUserUid != uid;
    }

    function projectPath(projectId) {
      return /databases/$(database)/documents/projects/$(projectId);
    }

    function projectMemberPath(projectId, uid) {
      return /databases/$(database)/documents/projects/$(projectId)/members/$(uid);
    }

    function memberInvitePath(projectId) {
      return /databases/$(database)/documents/projects/$(projectId)/memberInvites/$(request.auth.token.email);
    }

    function hasVerifiedEmail() {
      return signedIn()
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }

    function hasPendingInvite(projectId) {
      return hasVerifiedEmail()
        && exists(memberInvitePath(projectId))
        && get(memberInvitePath(projectId)).data.status == 'pending'
        && get(memberInvitePath(projectId)).data.email == request.auth.token.email
        && get(memberInvitePath(projectId)).data.role in ['editor', 'viewer'];
    }

    function validInviteClaimProjectUpdate(projectId) {
      let before = resource.data.memberUids;
      let after = request.resource.data.memberUids;
      let added = after.removeAll(before);
      let removed = before.removeAll(after);
      return hasPendingInvite(projectId)
        && before is list
        && after is list
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids'])
        && added.size() == 1
        && added[0] == request.auth.uid
        && removed.size() == 0
        && !exists(projectMemberPath(projectId, request.auth.uid))
        && existsAfter(projectMemberPath(projectId, request.auth.uid))
        && getAfter(projectMemberPath(projectId, request.auth.uid)).data.role
          == get(memberInvitePath(projectId)).data.role;
    }

    function validInvitedMemberCreate(projectId, uid) {
      return uid == request.auth.uid
        && hasPendingInvite(projectId)
        && request.resource.data.keys().hasOnly([
          'uid', 'role', 'displayName', 'email', 'joinedAt', 'profileUpdatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'uid', 'role', 'displayName', 'email', 'joinedAt', 'profileUpdatedAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == get(memberInvitePath(projectId)).data.role
        && request.resource.data.role in ['editor', 'viewer']
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 100
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.joinedAt == request.time
        && request.resource.data.profileUpdatedAt == request.time
        && getAfter(projectPath(projectId)).data.memberUids.hasAny([request.auth.uid]);
    }

    function validMemberProfileUpdate(uid) {
      return uid == request.auth.uid
        && hasVerifiedEmail()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'email', 'profileUpdatedAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 100
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.profileUpdatedAt == request.time;
    }

    function validOwnerRoleUpdate(projectId, uid) {
      return isOwner(projectId)
        && uid != request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && validRole(request.resource.data.role)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'updatedAt'])
        && request.resource.data.updatedAt == request.time;
    }

    function validMemberInviteCreate(projectId, email) {
      return request.resource.data.keys().hasOnly([
          'projectId', 'projectName', 'email', 'role', 'invitedByUid',
          'invitedByName', 'status', 'createdAt', 'updatedAt', 'acceptedAt',
          'emailStatus', 'emailSentAt', 'emailLastError', 'emailSendCount',
          'emailLastAttemptAt'
        ])
        && request.resource.data.keys().hasAll([
          'projectId', 'projectName', 'email', 'role', 'invitedByUid',
          'invitedByName', 'status', 'createdAt', 'updatedAt', 'acceptedAt',
          'emailStatus', 'emailSentAt', 'emailLastError', 'emailSendCount',
          'emailLastAttemptAt'
        ])
        && request.resource.data.projectId == projectId
        && request.resource.data.email == email
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.email.size() <= 254
        && request.resource.data.role in ['editor', 'viewer']
        && request.resource.data.invitedByUid == request.auth.uid
        && request.resource.data.invitedByName is string
        && request.resource.data.invitedByName.size() > 0
        && request.resource.data.invitedByName.size() <= 100
        && request.resource.data.projectName is string
        && request.resource.data.projectName.size() > 0
        && request.resource.data.projectName.size() <= 200
        && request.resource.data.status == 'pending'
        && request.resource.data.acceptedAt == null
        && request.resource.data.emailStatus == 'not_sent'
        && request.resource.data.emailSentAt == null
        && request.resource.data.emailLastError == null
        && request.resource.data.emailSendCount == 0
        && request.resource.data.emailLastAttemptAt == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function validInviteRevoke() {
      return resource.data.status == 'pending'
        && request.resource.data.status == 'revoked'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.updatedAt == request.time;
    }

    function validInviteRestart(projectId, email) {
      return resource.data.status in ['accepted', 'revoked']
        && validMemberInviteCreate(projectId, email);
    }

    function validInviteAccept(projectId) {
      return hasVerifiedEmail()
        && resource.data.email == request.auth.token.email
        && resource.data.status == 'pending'
        && resource.data.role in ['editor', 'viewer']
        && request.resource.data.status == 'accepted'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'acceptedAt', 'updatedAt'])
        && request.resource.data.acceptedAt == request.time
        && request.resource.data.updatedAt == request.time
        && getAfter(projectPath(projectId)).data.memberUids.hasAny([request.auth.uid])
        && getAfter(projectMemberPath(projectId, request.auth.uid)).data.uid == request.auth.uid
        && getAfter(projectMemberPath(projectId, request.auth.uid)).data.role == resource.data.role;
    }

    function memberUidsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['memberUids']);
    }

    function validMemberUidsChange(projectId) {
      let before = resource.data.memberUids;
      let after = request.resource.data.memberUids;
      let added = after.removeAll(before);
      let removed = before.removeAll(after);
      return after is list
        && after.size() == after.toSet().size()
        && ((added.size() == 0 && removed.size() == 0)
          || (added.size() == 1
            && removed.size() == 0
            && !exists(projectMemberPath(projectId, added[0]))
            && existsAfter(projectMemberPath(projectId, added[0])))
          || (added.size() == 0
            && removed.size() == 1
            && exists(projectMemberPath(projectId, removed[0]))
            && !existsAfter(projectMemberPath(projectId, removed[0]))));
    }

    function revisionIncremented(key) {
      let before = resource.data.get('revisions', {}).get(key, 0);
      let afterRevisions = request.resource.data.get('revisions', {});
      return afterRevisions.get(key, -1) is int
        && afterRevisions.get(key, -1) == before + 1
        && afterRevisions.diff(resource.data.get('revisions', {})).affectedKeys().hasOnly([key]);
    }

    function validSectionRevisionChange() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let performanceChanged = changed.hasAny([
        'performanceInfo', 'venue', 'performances', 'tickets',
        'cast', 'staff', 'contact', 'credits'
      ]);
      let productionChanged = changed.hasAny(['production']);
      let productionSections = request.resource.data.get('production', {})
        .diff(resource.data.get('production', {})).affectedKeys();
      return (!performanceChanged
          && !productionChanged
          && !changed.hasAny(['revisions']))
        || (performanceChanged
          && !productionChanged
          && revisionIncremented('performanceInfo'))
        || (!performanceChanged
          && productionChanged
          && ((productionSections.hasOnly(['venue']) && revisionIncremented('venue'))
            || (productionSections.hasOnly(['flyer']) && revisionIncremented('flyer'))
            || (productionSections.hasOnly(['web']) && revisionIncremented('web'))
            || (productionSections.hasOnly(['tickets']) && revisionIncremented('ticket'))
            || (productionSections.hasOnly(['reception']) && revisionIncremented('reception'))
            || (productionSections.hasOnly(['accounting']) && revisionIncremented('accounting'))));
    }

    match /projects/{projectId} {
      allow create: if signedIn()
        && request.resource.data.memberUids is list
        && request.resource.data.memberUids.hasAll([request.auth.uid])
        && request.resource.data.memberUids.hasOnly([request.auth.uid])
        && getAfter(projectMemberPath(projectId, request.auth.uid)).data.role == 'owner';
      allow get: if isMember(projectId);
      allow list: if signedIn()
        && request.auth.uid in resource.data.memberUids;
      allow update: if ((isOwner(projectId) && validMemberUidsChange(projectId))
          || (canEdit(projectId) && memberUidsUnchanged())
          || validInviteClaimProjectUpdate(projectId))
        && validSectionRevisionChange();
      allow delete: if isOwner(projectId);

      match /members/{uid} {
        allow read: if isMember(projectId);
        allow create: if (isOwner(projectId)
            && request.resource.data.uid == uid
            && validRole(request.resource.data.role)
            && getAfter(projectPath(projectId)).data.memberUids.hasAny([uid]))
          || (signedIn()
            && uid == request.auth.uid
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.role == 'owner'
            && getAfter(projectPath(projectId)).data.memberUids.hasAll([request.auth.uid])
            && getAfter(projectPath(projectId)).data.memberUids.hasOnly([request.auth.uid]))
          || validInvitedMemberCreate(projectId, uid);
        allow update: if validOwnerRoleUpdate(projectId, uid) || validMemberProfileUpdate(uid);
        allow delete: if isOwner(projectId)
          && uid != request.auth.uid
          && !getAfter(projectPath(projectId)).data.memberUids.hasAny([uid]);
      }

      match /tasks/{taskId} {
        allow read: if isMember(projectId);
        allow create, update, delete: if canEdit(projectId);
      }

      match /rehearsals/{rehearsalId} {
        allow read: if isMember(projectId);
        allow create: if canEdit(projectId) && validRehearsalCreate();
        allow update: if canEdit(projectId) && validRehearsalUpdate();
        allow delete: if canEdit(projectId);
      }

      match /participants/{participantId} {
        allow read: if isMember(projectId);
        allow create: if canEdit(projectId) && validParticipantCreate(projectId, participantId);
        allow update: if canEdit(projectId) && validParticipantUpdate(projectId, participantId);
        allow delete: if false;
      }

      match /participantLinkedUsers/{uid} {
        allow read: if canEdit(projectId);
        allow create: if canEdit(projectId) && validParticipantLinkedUserData(projectId, uid);
        allow update: if canEdit(projectId)
          && validParticipantLinkedUserData(projectId, uid)
          && previousParticipantLinkReleased(projectId, uid);
        allow delete: if canEdit(projectId)
          && (!existsAfter(participantPath(projectId, resource.data.participantId))
            || getAfter(participantPath(projectId, resource.data.participantId)).data.linkedUserUid != uid);
      }

      match /activityLogs/{logId} {
        allow read: if isMember(projectId);
        allow create: if canEdit(projectId) && validActivityLog();
        allow update, delete: if false;
      }

      match /feedback/{feedbackId} {
        allow read: if isMember(projectId);
        allow create: if isMember(projectId) && validFeedbackCreate(projectId);
        allow update: if isOwner(projectId) && validFeedbackUpdate();
        allow delete: if false;
      }

      match /memberInvites/{email} {
        allow read: if isOwner(projectId)
          || (hasVerifiedEmail() && resource.data.email == request.auth.token.email);
        allow create: if isOwner(projectId) && validMemberInviteCreate(projectId, email);
        allow update: if (isOwner(projectId)
            && (validInviteRevoke() || validInviteRestart(projectId, email)))
          || validInviteAccept(projectId);
        allow delete: if false;
      }
    }

    match /{path=**}/memberInvites/{email} {
      allow list: if hasVerifiedEmail()
        && resource.data.email == request.auth.token.email;
    }

    // カテゴリは現行の全公演共通マスタ。Phase 1では認証済みユーザーが管理する。
    match /categories/{categoryId} {
      allow read, write: if signedIn();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
