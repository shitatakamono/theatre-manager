{
  "compilerOptions": {
    "baseUrl": "..",
    "allowImportingTsExtensions": true,
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noEmit": true,
    "paths": {
      "@/*": ["*"],
      "server-only": ["functions/src/server-only.ts"]
    },
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
